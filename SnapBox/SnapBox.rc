// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_SNAPBOX             ICON                    "..\\images\\SnapBox.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_NOTIFYICONMENU MENUEX 
BEGIN
    POPUP "Dummy",                          0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Snap\tCtrl+PrtScr",          IDM_SNAP,MFT_STRING,MFS_ENABLED
        MENUITEM "&Reopen Last\tCtrl+Shift+PrtScr", IDM_REOPEN,MFT_STRING,MFS_ENABLED
        MENUITEM "Close &All",                  IDM_CLOSEALL,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Options...",                 IDM_OPTIONS,MFT_STRING,MFS_ENABLED
        MENUITEM "A&bout...",                   IDM_ABOUT,MFT_STRING,MFS_ENABLED
        MENUITEM "E&xit",                       IDM_EXIT,MFT_STRING,MFS_ENABLED
    END
END

IDC_CAPTUREMENU MENUEX 
BEGIN
    POPUP "Dummy",                          0,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Copy",                       IDM_COPY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Save As...",                 IDM_SAVE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Quicksave",                  IDM_QUICKSAVE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Share...",                   IDM_SHARE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Close &All",                  IDM_CLOSEALL,MFT_STRING,MFS_ENABLED
        MENUITEM "C&lose",                      IDM_CLOSE,MFT_STRING,MFS_ENABLED
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SnapBox"
FONT 8, "Tahoma", 0, 0, 0x1
BEGIN
    ICON            128,IDC_STATIC,14,14,21,20
    LTEXT           "SnapBox, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2009",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_OPTIONS DIALOGEX 0, 0, 312, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "SnapBox Options"
FONT 8, "Tahoma", 0, 0, 0x1
BEGIN
    RTEXT           "&Snaps To Keep In History",IDC_STATIC,4,5,96,8
    EDITTEXT        IDC_MAXHISTORY,102,4,40,12,ES_NUMBER
    CONTROL         "",IDC_MAXHISTORYUPDWN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_HOTTRACK,143,5,10,10
	LTEXT			"(Maximum 20)",IDC_STATIC,146,5,96,8
    PUSHBUTTON      "C&lear History",IDC_CLEARHISTORY,258,4,50,14
    RTEXT           "&Default Snap Type",IDC_STATIC,4,19,96,8
    COMBOBOX        IDC_DEFAULTSAVETYPE,102,18,152,12,CBS_DROPDOWNLIST
    RTEXT           "&Quick Save Folder",IDC_STATIC,4,33,96,8
    EDITTEXT        IDC_QUICKSAVEPATH,102,32,152,12
    PUSHBUTTON      "&Browse...",IDC_QUICKSAVEPATHBROWSE,258,32,50,12
    CONTROL         "&Hide Snaps For New Snap",IDC_HIDEONNEWSNAP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,102,48,96,8
	CONTROL			"Show Hover &Information",IDC_SHOWHOVERINFO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,102,60,96,8
    DEFPUSHBUTTON   "OK",IDOK,206,72,50,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,258,72,50,14,WS_GROUP
END


