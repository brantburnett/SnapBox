<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <VcpkgTriplet>$(Platform)-windows-static</VcpkgTriplet>
    <XercesLicensePath>$(MSBuildProjectDirectory)\..\vcpkg_installed\$(VcpkgTriplet)\share\xerces-c\copyright</XercesLicensePath>
    <OutputType>Package</OutputType>
    <OutputName>SnapBox-$(Platform)</OutputName>
    <AcceptEula>wix7</AcceptEula>
    <DefineConstants>$(DefineConstants);Version=$(Version);XercesLicensePath=$(XercesLicensePath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    <ProjectReference Include="..\SnapBox\SnapBox.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="TrackInstallerVersion" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)installer-version.txt"
                      Lines="$(Version)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>