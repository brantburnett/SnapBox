<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <VcpkgTriplet Condition="'$(Platform)' == 'x64'">x64-windows-static</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Platform)' == 'ARM64'">arm64-windows-static</VcpkgTriplet>
    <XercesLicensePath>$(MSBuildProjectDirectory)\..\vcpkg_installed\$(VcpkgTriplet)\share\xerces-c\copyright</XercesLicensePath>
    <OutputType>Package</OutputType>
    <OutputName>SnapBox-$(Version)-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</OutputName>
    <AcceptEula>wix7</AcceptEula>
    <DefineConstants>$(DefineConstants);Version=$(Version);InstallerVersion=$(InstallerVersion);XercesLicensePath=$(XercesLicensePath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    <ProjectReference Include="..\SnapBox\SnapBox.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="TrackInstallerVersion" BeforeTargets="CoreCompile">
    <Error Condition="'$(InstallerVersion)' == ''"
           Text="Version '$(Version)' must begin with a numeric major.minor.patch version." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)installer-version.txt"
                      Lines="$(Version)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>